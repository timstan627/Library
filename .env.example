# ===========================================
# Student Resource Library - Environment Config
# ===========================================
# Copy this file to .env and fill in values

# Database
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://admin:${DB_PASSWORD}@db:5432/student_library

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Security Keys (generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_32_byte_hex_secret_key
JWT_SECRET_KEY=generate_another_32_byte_hex_secret_key
HMAC_SECRET_KEY=generate_yet_another_32_byte_hex_secret_key

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Telegram API (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_PRIMARY_CHANNEL=-1001234567890
TELEGRAM_BACKUP_CHANNEL=-1009876543210

# File Upload Limits
MAX_FILE_SIZE_MB=50
STORAGE_QUOTA_MB=500
ALLOWED_EXTENSIONS=pdf,docx,pptx,xlsx,zip,txt,md,jpg,png

# Features
ENABLE_MFA=true
ENABLE_RATE_LIMITING=true
ENABLE_SENTRY=false
SENTRY_DSN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Student Resource Library

# Environment
ENVIRONMENT=development
DEBUG=true
