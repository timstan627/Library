# Student Resource Library — backend environment template.
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# ── Application ────────────────────────────────────────────────────────
APP_NAME="Student Resource Library"
# Public URL of the FRONTEND (used for CORS + email links)
APP_URL="http://127.0.0.1:3000"
ENVIRONMENT="development"          # development | production
DEBUG=true                         # enables /docs, /openapi.json, /metrics

# ── Database ───────────────────────────────────────────────────────────
# SQLite file lives in backend/ (path managed in app/core/database.py).
# DATABASE_URL is kept for compatibility but unused.

# ── Security ───────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Empty values fall back to a process-local random secret (tokens die on restart).
SECRET_KEY=""
JWT_SECRET_KEY=""
HMAC_SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial admin bootstrap (seeded on first startup; no credentials in code)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Reverse proxies allowed to set X-Forwarded-For / X-Real-IP (comma-separated IPs)
TRUSTED_PROXIES="127.0.0.1,::1"

# ── Telegram storage ───────────────────────────────────────────────────
# Files are stored as documents in two private Telegram channels.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_PRIMARY_CHANNEL=""       # channel id (numeric, negative for supergroups)
TELEGRAM_BACKUP_CHANNEL=""        # receives DB backups
TELEGRAM_OWNER_ID=""              # your Telegram user id (admin commands)

# ── Email (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="Student Library"

# ── Uploads ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
STORAGE_QUOTA_MB=104857600         # per-user quota in MB
ALLOWED_EXTENSIONS="pdf,docx,pptx,xlsx,zip,txt,md,jpg,png"

# ── Features & limits ─────────────────────────────────────────────────
ENABLE_MFA=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
